# SmartNet Tracker — example configuration.
# Copy to `.env` next to the binary (or run it from the folder containing this file),
# and the tracker will automatically pick up values via `dotenvy`.
#
# All variables below are optional: without `.env`, the tracker starts with the default
# values shown to the right of `=`.

# --- Basic HTTP server parameters ---
# Port on which the tracker listens (default: 7374).
SMARTNET_TRACKER_PORT=7374

# Path to the sled database (directory is created automatically).
SMARTNET_TRACKER_DB=./tracker-data

# TTL of the announcement record in seconds: if a provider does not send a heartbeat within
# this time, the record expires and is removed. Default: 120.
SMARTNET_TRACKER_TTL=120

# Log each accepted/rejected announcement (useful for debugging).
# Disabled by values 0/false/off/no. Default: ON.
SMARTNET_TRACKER_LOG_ANNOUNCE=1

# Seeding economy: on-chain verification of publication payment + heartbeat accounting of K_up.
# OFF (0/false/off/no) = emergency mode, returning ALL announcements in /apps without
# checking payment. Default: ON.
ENABLE_INCENTIVIZED_SEEDING=1

# --- Official registry (Official Repository) ---
# Comma-separated pool of SmartHoldem REST nodes. Never use a single hardcoded node in
# production — the tracker checks the list and uses the first live one. Default: the built-in
# mainnet pool (node0..node3.smartholdem.io + node0.sth.cx).
# SMARTHOLDEM_NODES=node0.smartholdem.io,node1.smartholdem.io

# Address registry of trusted developers on the SmartHoldem blockchain.
OFFICIAL_DEVELOPERS=SdevsH3kMbcCFWnyYVtD2UYnBQQm66MxDn

# Address registry of approved dApps (by appId).
OFFICIAL_DAPPS=SdAppjWaQf4v2JjuubvtwsKe3yuUCuq8i8

# Initial seed list of developer addresses separated by commas — fallback if the blockchain
# is unavailable at startup. The ORACLE admin address is always appended.
# DEVELOPERS=Saddress1,Saddress2

# --- Signing /seeders-dht responses (optional) ---
# Operator secret key (secp256k1, hex, 32 bytes). If set, GET /seeders-dht
# is signed with ECDSA; clients with a pinned pubkey reject forgeries.
# Empty value = responses are not signed.
# OPERATOR_SECRET=

# --- Logging management ---
# Standard tracing-subscriber filter (for example: smartnet_tracker=debug,tower_http=info).
# RUST_LOG=smartnet_tracker=info,tower_http=warn
